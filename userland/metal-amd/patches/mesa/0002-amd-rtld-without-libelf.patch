diff --git a/src/amd/common/ac_rtld.c b/src/amd/common/ac_rtld.c
index 6f91fb7..ca57bc5 100644
--- a/src/amd/common/ac_rtld.c
+++ b/src/amd/common/ac_rtld.c
@@ -11,6 +11,42 @@
 #include "util/compiler.h"
 #include "util/u_math.h"
 
+#ifndef USE_LIBELF
+/* OneiOS: a build without libelf (radeonsi with ACO alone, -Damd-use-llvm=false: iOS has no libelf).
+ * ACO makes raw binaries (SI_SHADER_BINARY_RAW), so radeonsi never opens an ELF; these say so if asked. */
+#include <stdio.h>
+#include <string.h>
+
+bool ac_rtld_open(struct ac_rtld_binary *binary, struct ac_rtld_open_info i)
+{
+   memset(binary, 0, sizeof(*binary));
+   fprintf(stderr, "amd: ac_rtld: an ELF shader binary, but this build has no libelf (ACO only)\n");
+   return false;
+}
+
+void ac_rtld_close(struct ac_rtld_binary *binary)
+{
+   memset(binary, 0, sizeof(*binary));
+}
+
+bool ac_rtld_get_section_by_name(struct ac_rtld_binary *binary, const char *name, const char **data,
+                                 size_t *nbytes)
+{
+   return false;
+}
+
+bool ac_rtld_read_config(const struct ac_compiler_info *compiler_info,
+                         struct ac_rtld_binary *binary,
+                         struct ac_shader_config *config)
+{
+   return false;
+}
+
+int ac_rtld_upload(struct ac_rtld_upload_info *u)
+{
+   return -1;
+}
+#else
 #include <gelf.h>
 #include <libelf.h>
 #include <stdarg.h>
@@ -567,3 +603,4 @@ int ac_rtld_upload(struct ac_rtld_upload_info *u)
 #undef report_if
 #undef report_elf_if
 }
+#endif /* USE_LIBELF */
diff --git a/src/amd/common/meson.build b/src/amd/common/meson.build
index d0ff6c7..8f6fab2 100644
--- a/src/amd/common/meson.build
+++ b/src/amd/common/meson.build
@@ -217,10 +217,10 @@ if with_amdgpu_virtio
   link_with += libvdrm
 endif
 
+# OneiOS: ac_rtld.c always (without libelf it only says it cannot read ELF: radeonsi with ACO alone).
+amd_common_files += files('ac_rtld.c', 'ac_rtld.h')
 if dep_elf.found()
   amd_common_files += files(
-    'ac_rtld.c',
-    'ac_rtld.h',
     'ac_rgp_elf_object_pack.c',
   )
 endif

diff --git a/src/gallium/targets/air-metal/meson.build b/src/gallium/targets/air-metal/meson.build
new file mode 100644
index 0000000..8b6c26d
--- /dev/null
+++ b/src/gallium/targets/air-metal/meson.build
@@ -0,0 +1,62 @@
+# Copyright © 2026 OneiOS contributors
+# SPDX-License-Identifier: MIT
+#
+# OneiOS: the AIR Metal library of Jesvi-iOS (its libredwoodair, tools/mesa/air-metal.patch), built
+# where libgallium and every driver exist, as libOneiOSRadeonAir: the library OneiOSRadeonMetal.bundle
+# loads (userland/metal-amd). Its contract is src/compiler/air/air_metal.h. Jesvi declared it in
+# freedreno's and panfrost's directories; here it is a target of its own, so a softpipe-only build
+# (the host test) and the A56's radeonsi build read the same file.
+#
+# The screen: -Doneios-air-screen=radeonsi (set by userland/metal-amd/air/build.sh when the tree
+# defines oneios_radeonsi_screen_create, the guest Mesa stage's Darwin radeonsi over the virtio
+# amdgpu context) or none (rwa_device_open then fails with a reason unless RWA_SOFTWARE=1 asks for
+# softpipe, which only the host test does).
+
+air_metal_c_args = []
+air_metal_sources = files('../../../compiler/air/air_metal.c')
+air_metal_incs = [inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_gallium_winsys_sw, inc_gallium_winsys,
+                  inc_gallium_drivers]
+air_metal_deps = [dep_m, dep_thread, idep_air, idep_nir, idep_mesautil, idep_xmlconfig, driver_softpipe]
+air_metal_link_args = []
+if get_option('oneios-air-screen') == 'radeonsi'
+  if not with_gallium_radeonsi
+    error('oneios-air-screen=radeonsi needs radeonsi in -Dgallium-drivers')
+  endif
+  if not get_option('oneios-radeonsi-screen')
+    error('oneios-air-screen=radeonsi needs -Doneios-radeonsi-screen=true (src/gallium/targets/oneios-radeonsi)')
+  endif
+  air_metal_c_args += '-DONEIOS_AIR_RADEONSI=1'
+  # oneios_radeonsi_screen_create compiled into this library (the target's own sources, include directories and
+  # dependencies, radeonsi among them): the bundle carries one library, not this one beside liboneios_radeonsi.dylib
+  air_metal_sources += oneios_radeonsi_sources
+  air_metal_incs += oneios_radeonsi_incs
+  air_metal_deps += oneios_radeonsi_deps
+endif
+if host_machine.system() == 'darwin'
+  # dlopened by its full path inside the bundle (OneiOSRadeonMetal.bundle/libOneiOSRadeonAir.dylib)
+  air_metal_link_args += '-Wl,-install_name,@loader_path/libOneiOSRadeonAir.dylib'
+endif
+
+libair_metal = shared_library(
+  'OneiOSRadeonAir',
+  air_metal_sources,
+  c_args : air_metal_c_args,
+  include_directories : air_metal_incs,
+  dependencies : air_metal_deps,
+  link_with : [libgallium, libgalliumvl_stub, libws_null],
+  link_args : air_metal_link_args,
+  build_by_default : false,
+  install : false,
+)
+
+# air_metal_test: the library driven the way the Metal driver drives it, on softpipe. It is given the
+# frontend's include directory and nothing else, so a call air_metal.h does not provide is a test that
+# cannot be written (Jesvi-iOS's words; userland/metal-amd/air/host-test.sh runs it).
+air_metal_test = executable(
+  'air_metal_test',
+  files('../../../compiler/air/air_metal_test.c'),
+  include_directories : include_directories('../../../compiler/air'),
+  link_with : [libair_metal],
+  build_by_default : false,
+  install : false,
+)

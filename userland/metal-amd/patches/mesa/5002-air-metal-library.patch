+++ b/meson.build
@@ -1109,6 +1109,7 @@ with_gfx_compute = [
   with_gallium_va and with_video_encode,
   with_gallium_mediafoundation and with_video_encode,
   get_option('oneios-radeonsi-screen'),
+  get_option('oneios-air'),   # OneiOS: the AIR Metal library compiles Metal shaders (5002-air-metal-library.patch)
 ].contains(true)
 if with_gfx_compute
   pre_args += '-DHAVE_GFX_COMPUTE'

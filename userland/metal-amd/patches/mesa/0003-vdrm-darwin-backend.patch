+/* What vdrm_device_connect() calls on Darwin; fd only names the GPU (src/oneios/oneios_drm.h). */
+struct vdrm_device *vdrm_darwin_connect(int fd, uint32_t context_type);
+
+/* Why the last vdrm_darwin_connect() of this process gave no device ("" after a success). */
+const char *vdrm_darwin_last_error(void);

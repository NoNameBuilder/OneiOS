+/* Whether vdev is a Darwin one. */
+bool vdrm_is_darwin(struct vdrm_device *vdev);
+
+/* The DRM syncobjs of a Darwin device (binary only), for the amdgpu winsys; NULL for another vdrm device. */
+struct util_sync_provider *vdrm_darwin_get_sync(struct vdrm_device *vdev);
+
+/* Wait (in the kernel, no polling) until (ring, fence) of an EXECBUFFER retires; 0, -ETIME or -errno. */
+int vdrm_darwin_wait(struct vdrm_device *vdev, uint32_t ring, uint64_t fence, uint64_t timeout_ns);
+
+/* A guest blob over the caller's own pages ([address, address + size), 4 KiB aligned, wired until the
+ * handle's close; the caller keeps its own mapping, so the BO is not MAPped): CREATE_BLOB_USER, with the
+ * driver's ccmd (GEM_NEW) as for vdrm_bo_create. The handle, or 0. */
+uint32_t vdrm_darwin_bo_create_user(struct vdrm_device *vdev, void *address, size_t size, uint32_t blob_flags,
+                                    uint64_t blob_id, struct vdrm_ccmd_req *req);
+

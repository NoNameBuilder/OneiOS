diff --git a/src/amd/common/virtio/amdgpu_virtio_bo.c b/src/amd/common/virtio/amdgpu_virtio_bo.c
index 7d3a54f..96cc50f 100644
--- a/src/amd/common/virtio/amdgpu_virtio_bo.c
+++ b/src/amd/common/virtio/amdgpu_virtio_bo.c
@@ -60,6 +60,11 @@ struct amdvgpu_host_blob *create_host_blob(uint32_t kms_handle,
 
 static
 void destroy_host_blob(amdvgpu_device_handle dev, struct amdvgpu_host_blob *hb) {
+#ifdef HAVE_VDRM_DARWIN
+   /* OneiOS: the CPU view is the kernel's mapping into this task (vdrm_darwin.c MAP); GEM_CLOSE below
+    * unmaps it. munmap() here would leave the kernel's mapping object pointing at a hole. */
+   hb->cpu_addr = NULL;
+#endif
    if (hb->cpu_addr) {
       int r = os_munmap(hb->cpu_addr, hb->alloc_size);
       assert(r == 0);
@@ -311,8 +316,12 @@ int amdvgpu_bo_cpu_unmap(amdvgpu_device_handle dev, amdvgpu_bo_handle bo) {
    }
    assert(bo->host_blob->cpu_addr);
    if (p_atomic_dec_zero(&bo->host_blob->map_count)) {
+#ifdef HAVE_VDRM_DARWIN
+      /* OneiOS: the kernel's mapping stays until GEM_CLOSE (destroy_host_blob); a later map takes it again. */
+#else
       r = os_munmap(bo->host_blob->cpu_addr, bo->host_blob->alloc_size);
       bo->host_blob->cpu_addr = NULL;
+#endif
    }
    simple_mtx_unlock(&bo->host_blob->cpu_access_mutex);
 

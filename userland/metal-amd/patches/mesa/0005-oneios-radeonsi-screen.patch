+/*
+ * OneiOS: Mesa's radeonsi as a bare Gallium screen, for the A56's Metal plug-in (OneiOSRadeonMetal), which
+ * sits on the pipe_screen directly (no GL or Vulkan frontend). On Darwin the screen runs over the amdgpu
+ * virtio native context through the Darwin vdrm backend (src/virtio/vdrm/vdrm_darwin.c); on Linux over a
+ * virtio_gpu render node (for building and testing the same code there).
+ *
+ * Copyright 2026 OneiOS contributors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef ONEIOS_RADEONSI_H
+#define ONEIOS_RADEONSI_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_screen;
+
+/* The radeonsi screen of this process's GPU, or NULL with the reason in why (NUL-terminated, cut to
+ * why_size). The screen's own destroy() releases it (and, with the last screen, the GPU connection). */
+struct pipe_screen *oneios_radeonsi_screen_create(char *why, size_t why_size);
+
+#ifdef __cplusplus
+}
+#endif

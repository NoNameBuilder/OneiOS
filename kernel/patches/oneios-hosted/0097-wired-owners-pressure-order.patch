+#if XNU_HOSTED
+/*
+ * 0097: who hears of memory pressure, and when.
+ *
+ * At a rise XNU notifies one process at a time, 250 ms apart (INTER_NOTIFICATION_DELAY), the least important first and the
+ * largest within a band (vm_pressure_select_optimal_candidate_to_notify), privileged listeners before all. On this guest
+ * nearly all of the RAM iOS can give back at a rise is the GPU memory of the render server and the apps that draw
+ * (backboardd held 917 MiB of GPU blobs, WebKit's GPU process 475, the session of 2026-11-23 22:19; every blob is wired
+ * guest RAM), and those are the most important processes, so they came last: a round over 150-300 listeners takes 40-75 s,
+ * and a level that falls back to normal before the round reaches them (the long-idle kills at the warning free a little)
+ * ends it there. oneios-pressure-big=MB (512; 0: XNU's order, the behaviour before 0097): at a rise, a process whose
+ * footprint is at least that many MiB is notified first, the largest first, as a privileged listener would be (Apple's
+ * privileged listeners still go before them). Each one is notified once per level, as every process is; nothing else in
+ * the order or the delays changes.
+ *
+ * The line, from the oneios-wired report (vm_resident.c, every oneios-wired-log seconds), two lines:
+ *   oneios-pressure: level warning (memorystatus_level 15%, available 875 MiB; warning below 795, normal above 914,
+ *     critical below 212 MiB); big first at 512 MiB
+ *   oneios-pressure: 60 s: rises +2, falls +1; notes +40 (warning 38, critical 2, normal 0; big first 2); longest round
+ *     9100 ms; last: backboardd[64] W 1214M 31 s, ...
+ * A round runs from the first note at a level to the last process that wanted that level. The last notes are the newest
+ * four, with the level (W warning, C critical, N normal), the footprint and how long ago.
+ */
+static TUNABLE(uint32_t, hosted_pressure_big_mb, "oneios-pressure-big", 512);
+extern unsigned int memorystatus_level;
+static bool hosted_pressure_picked_big;        /* the last candidate came from the rule above (the pressure thread only) */
+static struct {
+	uint32_t rises, falls, notes[3], big;
+	uint64_t round_start, longest_round;
+	vm_pressure_level_t seen;
+	struct { char name[20]; int pid; uint8_t level; uint32_t mb; uint64_t at; } last[4];
+	unsigned int next;
+} hosted_pressure;                              /* written by the pressure thread with the klist lock held */
+
+static void
+hosted_pressure_noted(proc_t p, task_t task, vm_pressure_level_t level)
+{
+	unsigned int i = hosted_pressure.next++ % 4;
+	strlcpy(hosted_pressure.last[i].name, proc_best_name(p), sizeof(hosted_pressure.last[i].name));
+	hosted_pressure.last[i].pid = proc_getpid(p);
+	hosted_pressure.last[i].level = (uint8_t)level;
+	hosted_pressure.last[i].mb = (uint32_t)MIN(UINT32_MAX, get_task_phys_footprint(task) >> 20);
+	hosted_pressure.last[i].at = mach_absolute_time();
+	hosted_pressure.notes[level == kVMPressureCritical ? 1 : level == kVMPressureNormal ? 2 : 0]++;
+	hosted_pressure.big += hosted_pressure_picked_big;
+}
+
+/* the level as the notify loop sees it: rises, falls and where a round starts */
+static void
+hosted_pressure_level(vm_pressure_level_t level)
+{
+	if (level == hosted_pressure.seen) {
+		return;
+	}
+	if (level > hosted_pressure.seen) {
+		hosted_pressure.rises++;
+	} else {
+		hosted_pressure.falls++;
+	}
+	hosted_pressure.seen = level;
+	hosted_pressure.round_start = mach_absolute_time();
+}
+
+static void
+hosted_pressure_round_done(void)
+{
+	if (hosted_pressure.round_start) {
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - hosted_pressure.round_start, &ns);
+		hosted_pressure.longest_round = MAX(hosted_pressure.longest_round, ns);
+		hosted_pressure.round_start = 0;
+	}
+}
+
+void hosted_pressure_report(void);
+void
+hosted_pressure_report(void)
+{
+	static uint64_t last;
+	static uint32_t shown_rises, shown_falls, shown_notes[3], shown_big;
+	const char *names[] = { "normal", "warning", "urgent", "critical" };
+	vm_pressure_level_t level = memorystatus_vm_pressure_level;
+	uint64_t now = mach_absolute_time(), span = 0;
+#if CONFIG_JETSAM
+	uint64_t soft = ptoa_64(memorystatus_get_soft_memlimit_page_shortage_threshold());
+	uint64_t critical = ptoa_64(memorystatus_get_critical_page_shortage_threshold());
+#else
+	uint64_t soft = 0, critical = 0;
+#endif
+	printf("oneios-pressure: level %s (memorystatus_level %u%%, available %llu MiB; warning below %llu, normal above %llu, "
+	    "critical below %llu MiB); big first at %u MiB\n", (unsigned)level < 4 ? names[level] : "?", memorystatus_level,
+	    (unsigned long long)(ptoa_64(memorystatus_get_available_page_count()) >> 20), (unsigned long long)(soft >> 20),
+	    (unsigned long long)((soft * 115 / 100) >> 20), (unsigned long long)(critical >> 20), hosted_pressure_big_mb);
+
+	char line[240];
+	memorystatus_klist_lock();
+	absolutetime_to_nanoseconds(last ? now - last : 0, &span);
+	size_t used = (size_t)snprintf(line, sizeof(line), "oneios-pressure: %llu s: rises +%u, falls +%u; notes +%u (warning %u, "
+	    "critical %u, normal %u; big first %u); longest round %llu ms; last:", (unsigned long long)(span / NSEC_PER_SEC),
+	    hosted_pressure.rises - shown_rises, hosted_pressure.falls - shown_falls,
+	    (hosted_pressure.notes[0] - shown_notes[0]) + (hosted_pressure.notes[1] - shown_notes[1]) +
+	    (hosted_pressure.notes[2] - shown_notes[2]), hosted_pressure.notes[0] - shown_notes[0],
+	    hosted_pressure.notes[1] - shown_notes[1], hosted_pressure.notes[2] - shown_notes[2], hosted_pressure.big - shown_big,
+	    (unsigned long long)(hosted_pressure.longest_round / NSEC_PER_MSEC));
+	for (unsigned int k = 1; k <= 4 && used < sizeof(line) - 1; k++) {
+		unsigned int i = (hosted_pressure.next - k) % 4;
+		if (hosted_pressure.next < k || !hosted_pressure.last[i].at) {
+			break;
+		}
+		uint64_t ago = 0;
+		absolutetime_to_nanoseconds(now - hosted_pressure.last[i].at, &ago);
+		int w = snprintf(line + used, sizeof(line) - used, "%s %s[%d] %c %uM %llu s", k > 1 ? "," : "",
+		    hosted_pressure.last[i].name, hosted_pressure.last[i].pid,
+		    hosted_pressure.last[i].level == kVMPressureCritical ? 'C' : hosted_pressure.last[i].level == kVMPressureNormal ? 'N' : 'W',
+		    hosted_pressure.last[i].mb, (unsigned long long)(ago / NSEC_PER_SEC));
+		used = w > 0 ? MIN(used + (size_t)w, sizeof(line) - 1) : used;
+	}
+	shown_rises = hosted_pressure.rises;
+	shown_falls = hosted_pressure.falls;
+	memcpy(shown_notes, hosted_pressure.notes, sizeof(shown_notes));
+	shown_big = hosted_pressure.big;
+	hosted_pressure.longest_round = 0;
+	memorystatus_klist_unlock();
+	last = now;
+	printf("%s%s\n", line, hosted_pressure.next ? "" : " none");
+}
+#endif /* XNU_HOSTED */

+#if XNU_HOSTED
+/*
+ * 0097: who holds the wired pages. The session of 2026-11-23 22:19 had "wired 3195" of 5302 MiB with nothing to name
+ * the owners. Every oneios-wired-log seconds (60; 0: never), from the free-page thread's oneios-mem report, XNU's own
+ * accounting by allocation site (what zprint reads: vm_page_diagnose, the counts, the tags, the kexts' sites, the kernel's
+ * sites and the zones) and the GPU's blobs (the gpu archive's counters, weak: 0 without it):
+ *   oneios-wired: 3195 MiB: kernelcache 96, boot 223 (stolen 40, booter 12), zones 180 of a 512 MiB map; compressor 269
+ *     apart; GPU blobs: own 2044, imported 629 (counted with their owners too)
+ *   oneios-wired: owners (MiB): IOKIT 2690, ZONE 180, kext com.apple.iokit.IOSurface 120, ..., rest 40, unnamed 12
+ *   oneios-wired: zones in use (MiB): VM.objects 40, ...
+ * "owners" are the sites that add to the wired count, largest first: a tag (VM_KERN_MEMORY_*), a kext by its identifier,
+ * or a kernel site by its unslid address (oneios-tool sym kernel names it). The hosted drivers are kernel code, so their
+ * wired pages (the GPU's blob pages that prepare() wires, the display's, the disks') are under IOKIT, and the GPU's own
+ * counters say how much of it is the GPU's. "unnamed" is the wired count less every site's: pages no site was charged
+ * with. Then the pressure line (kern_memorystatus_notify.c, hosted_pressure_report).
+ */
+static TUNABLE(uint32_t, hosted_wired_log_s, "oneios-wired-log", 60);
+extern volatile uint64_t droidvm_virtgpu_live[4] __attribute__((weak));
+extern void hosted_pressure_report(void);
+
+#define HOSTED_WIRED_TOP 10
+#define HOSTED_WIRED_MIB(bytes) ((unsigned long long)((bytes) >> 20))
+
+/* the `want` largest entries of info[] whose flags have all of `with` and none of `without`, largest first */
+static unsigned int
+hosted_wired_top(const mach_memory_info_t *info, unsigned int count, uint64_t with, uint64_t without,
+    unsigned int *top, unsigned int want)
+{
+	unsigned int n = 0;
+	for (unsigned int i = 0; i < count; i++) {
+		if ((info[i].flags & with) != with || (info[i].flags & without) || info[i].size == 0) {
+			continue;
+		}
+		unsigned int at = n < want ? n : want;
+		while (at > 0 && info[top[at - 1]].size < info[i].size) {
+			at--;
+		}
+		if (at >= want) {
+			continue;
+		}
+		for (unsigned int k = (n < want ? n : want - 1); k > at; k--) {
+			top[k] = top[k - 1];
+		}
+		top[at] = i;
+		n += n < want;
+	}
+	return n;
+}
+
+/* an entry's name: the tag's without its prefix, a kext's identifier, or a kernel site's unslid address */
+static void
+hosted_wired_name(const mach_memory_info_t *e, char *name, size_t size)
+{
+	if (e->flags & VM_KERN_SITE_NAMED) {
+		const char *s = e->name;
+		if (!strncmp(s, "VM_KERN_MEMORY_", 15)) {
+			s += 15;
+		} else if (!strncmp(s, "VM_KERN_COUNT_", 14)) {
+			s += 14;
+		}
+		strlcpy(name, s, size);
+		return;
+	}
+	switch (e->flags & VM_KERN_SITE_TYPE) {
+	case VM_KERN_SITE_KMOD: {
+		char kext[64] = "";
+		lck_ticket_lock(&vm_allocation_sites_lock, &vm_page_lck_grp_bucket);
+		vm_allocation_site_t *site = e->tag < VM_MAX_TAG_VALUE ? vm_allocation_sites[e->tag] : NULL;
+		if (site && (site->flags & VM_TAG_KMOD)) {
+			(void)OSKextGetKmodIDForSite(site, kext, sizeof(kext));   /* reads the account's kext: no lock */
+		}
+		lck_ticket_unlock(&vm_allocation_sites_lock);
+		snprintf(name, size, "kext %s", kext[0] ? kext : "?");
+		return;
+	}
+	case VM_KERN_SITE_KERNEL:
+		snprintf(name, size, "kernel 0x%llx", (unsigned long long)e->site);
+		return;
+	default:
+		snprintf(name, size, "tag %u", e->tag);
+		return;
+	}
+}
+
+static void
+hosted_wired_list(const char *title, const mach_memory_info_t *info, const unsigned int *top, unsigned int n,
+    uint64_t rest, uint64_t unnamed, bool tail)
+{
+	/* one line of at most ~240 characters: the console cuts a line past about 256 */
+	char line[240];
+	size_t used = (size_t)snprintf(line, sizeof(line), "oneios-wired: %s (MiB):", title);
+	for (unsigned int i = 0; i < n && used < sizeof(line) - 1; i++) {
+		char name[56];
+		hosted_wired_name(&info[top[i]], name, sizeof(name));
+		int w = snprintf(line + used, sizeof(line) - used, "%s %.40s %llu", i ? "," : "", name,
+		    HOSTED_WIRED_MIB(info[top[i]].size));
+		used = w > 0 ? MIN(used + (size_t)w, sizeof(line) - 1) : used;
+	}
+	if (tail && used < sizeof(line) - 1) {
+		snprintf(line + used, sizeof(line) - used, ", rest %llu, unnamed %llu", HOSTED_WIRED_MIB(rest),
+		    HOSTED_WIRED_MIB(unnamed));
+	}
+	printf("%s\n", line);
+}
+
+void hosted_wired_report(void);
+void
+hosted_wired_report(void)
+{
+	static uint64_t last;
+	uint64_t now = mach_absolute_time(), every = 0;
+	if (hosted_wired_log_s == 0) {
+		return;
+	}
+	/* the oneios-mem report comes every oneios-free-report-log seconds (30): a report a second early is due */
+	nanoseconds_to_absolutetime((uint64_t)(hosted_wired_log_s > 1 ? hosted_wired_log_s - 1 : 1) * NSEC_PER_SEC, &every);
+	if (last && now - last < every) {
+		return;
+	}
+	last = now;
+
+	unsigned int num = vm_page_diagnose_estimate();
+	mach_memory_info_t *info = kalloc_data((vm_size_t)num * sizeof(*info), Z_WAITOK | Z_ZERO);
+	if (info == NULL || vm_page_diagnose(info, num, 0, false) != KERN_SUCCESS) {
+		kfree_data(info, (vm_size_t)num * sizeof(*info));
+		printf("oneios-wired: no accounting this time (%u entries)\n", num);
+		return;
+	}
+	const mach_memory_info_t *counts = &info[num - VM_KERN_COUNTER_COUNT];
+	const uint64_t wired = counts[VM_KERN_COUNT_WIRED].size;
+	uint64_t named = 0;
+	for (unsigned int i = 0; i < num; i++) {
+		if ((info[i].flags & VM_KERN_SITE_WIRED) && !(info[i].flags & VM_KERN_SITE_HIDE)) {
+			named += info[i].size;
+		}
+	}
+	/* the zone tag is hidden from the wired sum (process_account): its pages are the zones' */
+	uint64_t zones = info[VM_KERN_MEMORY_ZONE].size, gpu_own = 0, gpu_imported = 0;
+	named += zones;
+	if (&droidvm_virtgpu_live[0] != NULL) {
+		gpu_own = droidvm_virtgpu_live[0];
+		gpu_imported = droidvm_virtgpu_live[1];
+	}
+	printf("oneios-wired: %llu MiB: kernelcache %llu, boot %llu (stolen %llu, booter %llu), zones %llu of a %llu MiB map; "
+	    "compressor %llu apart; GPU blobs: own %llu, imported %llu (counted with their owners too)\n",
+	    HOSTED_WIRED_MIB(wired), HOSTED_WIRED_MIB(counts[VM_KERN_COUNT_WIRED_STATIC_KERNELCACHE].size),
+	    HOSTED_WIRED_MIB(counts[VM_KERN_COUNT_WIRED_BOOT].size), HOSTED_WIRED_MIB(counts[VM_KERN_COUNT_STOLEN].size),
+	    HOSTED_WIRED_MIB(counts[VM_KERN_COUNT_BOOT_STOLEN].size), HOSTED_WIRED_MIB(zones),
+	    HOSTED_WIRED_MIB(counts[VM_KERN_COUNT_MAP_ZONE].size), HOSTED_WIRED_MIB(ptoa_64(VM_PAGE_COMPRESSOR_COUNT)),
+	    HOSTED_WIRED_MIB(gpu_own), HOSTED_WIRED_MIB(gpu_imported));
+
+	/* the owners: every site and count that adds to the wired sum, and the zone tag */
+	unsigned int top[HOSTED_WIRED_TOP];
+	mach_memory_info_t zone_tag = info[VM_KERN_MEMORY_ZONE];
+	info[VM_KERN_MEMORY_ZONE].flags = (zone_tag.flags | VM_KERN_SITE_WIRED) & ~(uint64_t)VM_KERN_SITE_HIDE;
+	unsigned int n = hosted_wired_top(info, num, VM_KERN_SITE_WIRED, VM_KERN_SITE_HIDE, top, HOSTED_WIRED_TOP);
+	uint64_t listed = 0;
+	for (unsigned int i = 0; i < n; i++) {
+		listed += info[top[i]].size;
+	}
+	hosted_wired_list("owners", info, top, n, named > listed ? named - listed : 0, wired > named ? wired - named : 0, true);
+	info[VM_KERN_MEMORY_ZONE] = zone_tag;
+
+	/* the zones' bytes in use, by view (what zprint lists per zone) */
+	n = hosted_wired_top(info, num, VM_KERN_SITE_ZONE_VIEW, 0, top, HOSTED_WIRED_TOP);
+	hosted_wired_list("zones in use", info, top, n, 0, 0, false);
+	kfree_data(info, (vm_size_t)num * sizeof(*info));
+
+	hosted_pressure_report();
+}
+#endif /* XNU_HOSTED */
+

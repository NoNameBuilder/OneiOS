+ * Bitmaps are kept until the task ends; oneios-perf's "nested exact" part says how many there are.
+ */
+static TUNABLE(uint32_t, hosted_nested_exact, "oneios-nested-exact", 1);
+#define HOSTED_NESTED_PAGES       (1u << (HOSTED_NESTED_BLOCK_SHIFT - ARM_PGSHIFT))     /* pages of a block: 8192 */
+#define HOSTED_NESTED_LEAF_WORDS  (HOSTED_NESTED_PAGES / 64)                           /* 128 words, 1 KiB */
+#define HOSTED_NESTED_TABLE       (HOSTED_NESTED_BITS - 1)                             /* blocks with a bitmap */
+static uint64_t hosted_nested_leaves, hosted_nested_tables;     /* bitmaps and tables alive (relaxed atomics) */
+
+/* The block of va in pmap's nested region, or HOSTED_NESTED_BITS - 1 past the bits, or -1 outside the region. */
+static inline int64_t
+hosted_nested_block(pmap_t nested, uint64_t va)
+{
+	if (nested == NULL || va < nested->nested_region_addr || va - nested->nested_region_addr >= nested->nested_region_size) {
+		return -1;
+	}
+	uint64_t bit = (va - nested->nested_region_addr) >> HOSTED_NESTED_BLOCK_SHIFT;
+	return (int64_t)(bit >= HOSTED_NESTED_BITS - 1 ? HOSTED_NESTED_BITS - 1 : bit);

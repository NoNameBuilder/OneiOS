+
+/* 0101: before a fill of va, in thread context with no lock held: the bitmap of va's block, if it is in the region. */
+static void
+hosted_nested_prepare(pmap_t pmap, uint64_t va)
+{
+	int64_t block = hosted_nested_exact ? hosted_nested_block(pmap->nested_pmap, va) : -1;
+
+	if (block < 0 || block >= HOSTED_NESTED_TABLE) {
+		return;
+	}
+	uint64_t **table = os_atomic_load(&pmap->hosted_nested_pages, acquire);
+	if (table == NULL) {
+		table = kalloc_data(HOSTED_NESTED_TABLE * sizeof(uint64_t *), Z_WAITOK | Z_ZERO);
+		if (table == NULL) {
+			return;
+		}
+		if (os_atomic_cmpxchg(&pmap->hosted_nested_pages, NULL, table, release)) {
+			os_atomic_inc(&hosted_nested_tables, relaxed);
+		} else {
+			kfree_data(table, HOSTED_NESTED_TABLE * sizeof(uint64_t *));
+			table = os_atomic_load(&pmap->hosted_nested_pages, acquire);
+		}
+	}
+	if (os_atomic_load(&table[block], acquire) != NULL) {
+		return;
+	}
+	uint64_t *leaf = kalloc_data(HOSTED_NESTED_LEAF_WORDS * sizeof(uint64_t), Z_WAITOK | Z_ZERO);
+	if (leaf == NULL) {
+		return;
+	}
+	if (os_atomic_cmpxchg(&table[block], NULL, leaf, release)) {
+		os_atomic_inc(&hosted_nested_leaves, relaxed);
+	} else {
+		kfree_data(leaf, HOSTED_NESTED_LEAF_WORDS * sizeof(uint64_t));
+	}

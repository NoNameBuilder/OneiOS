+
+/* 0101: the bitmap of a block, or NULL (then the 0045 block bit counts). The pmap's TLB word held. */
+static inline uint64_t *
+hosted_nested_leaf(pmap_t pmap, int64_t block)
+{
+	uint64_t **table = pmap->hosted_nested_pages;
+	return table != NULL && block >= 0 && block < HOSTED_NESTED_TABLE ? os_atomic_load(&table[block], acquire) : NULL;
